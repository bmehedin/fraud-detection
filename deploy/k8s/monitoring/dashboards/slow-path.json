{
  "uid": "fraud-slow-path",
  "title": "Slow path (Spark)",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "fraud-detection"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Input vs processing rate",
      "description": "Rows/sec arriving vs rows/sec Spark gets through. Processing below input for long = Spark cannot keep up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "metrics_fraud_driver_spark_streaming_s2_inputRate_total_Value",
          "legendFormat": "s2 input"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "metrics_fraud_driver_spark_streaming_s2_processingRate_total_Value",
          "legendFormat": "s2 processing"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "metrics_fraud_driver_spark_streaming_parquet_inputRate_total_Value",
          "legendFormat": "parquet input"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "metrics_fraud_driver_spark_streaming_parquet_processingRate_total_Value",
          "legendFormat": "parquet processing"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Batch latency",
      "description": "How long the last micro-batch took, end to end.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "metrics_fraud_driver_spark_streaming_s2_latency_Value",
          "legendFormat": "s2"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "metrics_fraud_driver_spark_streaming_parquet_latency_Value",
          "legendFormat": "parquet"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "S2 state rows",
      "description": "Rows held in the state store (last known location per card). Should plateau near the card count.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "metrics_fraud_driver_spark_streaming_s2_states_rowsTotal_Value",
          "legendFormat": "rows"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "S2 state size",
      "description": "Memory the state store uses. Unbounded growth = state is never evicted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "metrics_fraud_driver_spark_streaming_s2_states_usedBytes_Value",
          "legendFormat": "bytes"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "S2 watermark delay",
      "description": "How far the watermark trails wall-clock time. Events older than the watermark are dropped.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "time() - metrics_fraud_driver_spark_streaming_s2_eventTime_watermark_Value / 1000",
          "legendFormat": "now - watermark"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Driver JVM",
      "description": "local[*] mode: the driver also runs the executors, so this is all of Spark's JVM memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "metrics_fraud_driver_ExecutorMetrics_JVMHeapMemory_Value",
          "legendFormat": "heap used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "metrics_fraud_driver_ExecutorMetrics_JVMOffHeapMemory_Value",
          "legendFormat": "off-heap used"
        }
      ]
    }
  ]
}
