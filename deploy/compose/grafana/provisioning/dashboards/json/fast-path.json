{
  "uid": "fraud-fast-path",
  "title": "Fast path (redis-jobs)",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "fraud-detection"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Events/sec",
      "description": "Transactions consumed per second. ok = parsed and checked, dlq = malformed, sent to transactions.dlq.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (result) (rate(redis_jobs_events_total[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Alerts (last 5m)",
      "description": "Alerts produced to fraud.alerts in the last 5 minutes, per rule. Duplicates suppressed by the dedup key are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (rule) (increase(redis_jobs_alerts_total[5m]))",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Check latency",
      "description": "Time to run F1 + F3 against Redis for one transaction. Red line = 10 ms fast-path target.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(redis_jobs_check_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(redis_jobs_check_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(redis_jobs_check_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Consumer lag",
      "description": "Messages in transactions.raw not yet committed by redis-jobs. Commits happen every 100 records or 5 s, so small bumps are normal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"redis-jobs\"})",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Redis memory",
      "description": "Memory Redis holds: velocity sorted sets, blocklist sets, dedup keys. Flat over time = TTLs are expiring old keys.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Redis hit rate",
      "description": "Share of lookups where the key existed. blocklist:cards is empty so it always misses; blocklist:merchants hits. ~50% is normal: Redis is our state store, not a cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(redis_keyspace_hits_total[$__rate_interval]) / (rate(redis_keyspace_hits_total[$__rate_interval]) + rate(redis_keyspace_misses_total[$__rate_interval]))",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Redis ops/sec",
      "description": "Commands Redis executes per second. A steady multiple of events/sec; flattening under rising load = Redis is the limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(redis_commands_processed_total[$__rate_interval])",
          "legendFormat": "commands"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM",
      "description": "redis-jobs heap. A sawtooth is normal (allocate, GC, repeat); a rising floor suggests a leak.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "jvm_memory_used_bytes{job=\"redis-jobs\",area=\"heap\"}",
          "legendFormat": "heap used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "jvm_memory_max_bytes{job=\"redis-jobs\",area=\"heap\"}",
          "legendFormat": "heap max"
        }
      ]
    }
  ]
}